# Copy this file to .env. Never commit .env.

# Choose ONE provider:
#   none       -> no LLM, shows matching passages (works immediately, free)
#   ollama     -> free local model (install Ollama from ollama.com first)
#   anthropic  -> Claude API (needs a REAL key and prepaid credit)
LLM_PROVIDER=none

# Only needed when LLM_PROVIDER=anthropic. Paste your real key after the = sign.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.2
